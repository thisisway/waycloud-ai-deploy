# mcp-service. `docker compose up` already sets these for local development.
DATABASE_URL=postgres://waycloud:change-me@localhost:5432/waycloud_ai
PORT=3000
HOST=0.0.0.0

# Object storage (S3 API). Production: Cloudflare R2, endpoint https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=http://localhost:19000
# Only when clients reach the storage at a different address than the service does (local MinIO in Docker):
# S3_PUBLIC_ENDPOINT=http://localhost:19000
S3_REGION=auto
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_BUCKET=waycloud-ai

# WHMCS addon (modules/addons/waycloud_ai). Both or none. The secret is the same one saved in the addon settings
# (at least 32 chars). Without them plans come from the seed list and checkout is unavailable (local dev).
# ADDON_URL=https://app.waycloud.com.br/modules/addons/waycloud_ai/api.php
# ADDON_HMAC_SECRET=

# Previews: folder shared with the Nginx edge and the public URL pattern ({slug} is replaced).
PREVIEW_ROOT=/srv/previews
PREVIEW_URL_TEMPLATE=https://{slug}.wayleads.com.br
PREVIEW_TTL_HOURS=24
