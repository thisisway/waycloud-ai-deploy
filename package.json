  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^26.6.2",
    "fflate": "^0.8.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "zod": "^3.25.76"
  },
  "packageManager": "pnpm@11.8.0"
}
