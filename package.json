{
  "name": "waycloud-ai-deploy",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx apps/mcp-service/src/main.ts",
    "build:addon": "node scripts/build-addon-zip.mjs",
    "checkout:dev": "tsx scripts/create-checkout-link.ts",
